<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.Gatekeeper" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/selected</item>
        <item name="colorOnPrimaryContainer">@color/ink</item>
        <item name="colorSecondary">@color/gold</item>
        <item name="colorSecondaryContainer">@color/selected</item>
        <item name="colorOnSecondaryContainer">@color/ink</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/muted</item>
        <item name="colorOutline">@color/hairline</item>
        <item name="colorOutlineVariant">@color/hairline</item>
        <item name="colorError">@color/risk</item>
        <item name="android:colorBackground">@color/page</item>
        <item name="android:statusBarColor">@color/hero</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="materialCardViewStyle">@style/Widget.Gatekeeper.Card</item>
        <!-- Android 12+ system splash: same dark band and shield as the entry animation, so there is no flash. -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/hero</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/ic_shield</item>
        <item name="android:windowSplashScreenIconBackgroundColor" tools:targetApi="31">@color/hero</item>
    </style>

    <style name="Theme.Gatekeeper" parent="Base.Theme.Gatekeeper" />

    <!-- The link handler shows nothing unless the check has to wait. -->
    <style name="Theme.Gatekeeper.Translucent" parent="Theme.Gatekeeper">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Translucent</item>
    </style>

    <style name="Widget.Gatekeeper.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeColor">@color/hairline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="Widget.Gatekeeper.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">10dp</item>
    </style>

    <style name="Widget.Gatekeeper.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">@color/hairline</item>
        <item name="android:textColor">@color/ink</item>
        <item name="iconTint">@color/ink</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
    </style>

    <style name="Widget.Gatekeeper.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/muted</item>
        <item name="iconTint">@color/muted</item>
        <item name="iconGravity">textStart</item>
    </style>

    <style name="Widget.Gatekeeper.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/selected</item>
    </style>

    <style name="Text.Gatekeeper.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>

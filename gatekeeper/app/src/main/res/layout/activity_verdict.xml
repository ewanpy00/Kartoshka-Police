<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/verdict_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/title_ar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/block"
            android:textDirection="rtl"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/title_en"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text"
            android:textDirection="ltr"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/domain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="monospace"
            android:textColor="@color/text"
            android:textDirection="ltr"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/brand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/reasons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/offline_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/offline_note"
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/safe_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/accent"
            android:textAllCaps="false"
            android:textColor="@color/surface" />

        <Button
            android:id="@+id/go_back"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/go_back"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/report"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/report"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/details"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/details"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/open_anyway"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/open_anyway"
            android:textAllCaps="false"
            android:textColor="@color/muted" />
    </LinearLayout>
</ScrollView>

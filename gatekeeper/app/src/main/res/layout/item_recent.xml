<?xml version="1.0" encoding="utf-8"?>
<!-- A recent check on Home: verdict icon, defanged host, verdict and time, chevron. Opens the full result. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="10dp">

    <ImageView
        android:id="@+id/recent_icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/circle"
        android:importantForAccessibility="no"
        android:padding="8dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/recent_host"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:textColor="@color/ink"
            android:textDirection="ltr"
            android:textAlignment="viewStart"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/recent_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/recent_chevron"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron"
        android:tint="@color/muted" />
</LinearLayout>

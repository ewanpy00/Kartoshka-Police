# `make up` copies this file to .env and fills CORE_WRITE_TOKEN.

# Postgres
POSTGRES_USER=kartoshka
POSTGRES_PASSWORD=kartoshka_dev
POSTGRES_DB=kartoshka

# Service wiring (container-internal addresses)
DATABASE_URL=postgresql+psycopg://kartoshka:kartoshka_dev@postgres:5432/kartoshka
REDIS_URL=redis://redis:6379/0
RQ_QUEUE=deep
SANDBOX_URL=http://sandbox:8001
CERTSTREAM_URL=ws://certstream:8080/
DATA_DIR=/srv/data
# Where core reads the sandbox's page captures (the shared captures volume).
CAPTURES_DIR=/captures
CAPTURE_TIMEOUT_MS=15000
# Read by hunter and dnssync (core's address inside the compose network).
CORE_URL=http://core:8000

# Shared dev write token for blocklist-changing routes. Generated by `make up`.
CORE_WRITE_TOKEN=

# Batch endpoint. BATCH_CUTOFF was tuned on data/eval/test.csv (docs/app-plan.md, decision 11).
BATCH_URL_BUDGET_MS=3000
BATCH_CUTOFF=40
BATCH_CONCURRENCY=20

# Fast path: RDAP, DNS, GSB, VirusTotal and shortener expansion share this budget per check.
FAST_LOOKUP_BUDGET_MS=700
VERDICT_CACHE_TTL_S=600
# A deep analysis of the same host younger than this is reused instead of run again.
DEEP_REUSE_HOURS=6

# Published host ports
# BIND_ADDR applies to core, the resident screens and AdGuard's DNS port (stretch profile).
# BIND_ADDR=0.0.0.0 is for the demo phone only: it exposes them to the whole LAN.
BIND_ADDR=127.0.0.1
CORE_PORT=8000
# The console is always bound to 127.0.0.1.
CONSOLE_PORT=5173
# Resident screens (PWA); published on BIND_ADDR like core, so the demo phone can open them.
RESIDENT_PORT=5174

# AdGuard Home (stretch profile)
ADGUARD_DNS_PORT=5335
# AdGuard admin, created by the dnssync service on first start (scripts/env.sh generates the password).
ADGUARD_USER=admin
ADGUARD_PASSWORD=
ADGUARD_UI_PORT=3001

# Admin dashboard (docs/admin-dashboard.md)
TAKEDOWN_SLA_H=48
# Offline results count only when at least this far apart. For the live demo ("Check now" twice) set it to 1.
TAKEDOWN_RECHECK_MIN=60
TAKEDOWN_OFFLINE_CHECKS=2
# Domains linked to at least this many others count as hubs in the infrastructure graph.
GRAPH_HUB_DEGREE=50
BRAND_SPIKE_PER_HOUR=10
# Per device, for the resident screens
PREVIEW_RATE_PER_HOUR=10
REPORT_RATE_PER_HOUR=20

# Optional lookups. Each one runs only when its key is set; otherwise its source is "skipped".
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
SEARCH_API_KEY=

# AI layer (Claude through the Anthropic SDK). Off while ANTHROPIC_API_KEY is empty.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_TIMEOUT_S=60
AI_EFFORT=low
AI_SMS_TIMEOUT_S=20

# Hunter (hunter/app/sources.py)
# Sources to run: ct (Certificate Transparency), feeds (OpenPhish, URLhaus), nrd (WhoisDS daily list),
# watchlist (asks core every 5 minutes to re-check due domains).
HUNTER_SOURCES=ct,feeds,nrd,watchlist
# Cap on infrastructure-only CT candidates (random names on risky TLDs); each one lands in the officer queue.
HUNTER_INFRA_PER_MINUTE=5
# Free abuse.ch key for URLhaus; without it URLhaus is skipped.
URLHAUS_AUTH_KEY=

# DNS sync (dns/sync/shield.py)
# Seconds between pulls of the confirmed blocklist into AdGuard Home.
DNS_SYNC_EVERY_S=60
